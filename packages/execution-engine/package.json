{
  "name": "@tracedeck/execution-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../.. run verify:workspaces",
    "build": "npm --prefix ../trace-core run build && tsc -p tsconfig.json",
    "pretest": "npm --prefix ../.. run verify:workspaces",
    "test": "npm --prefix ../trace-core run build && vitest run test",
    "pretypecheck": "npm --prefix ../.. run verify:workspaces",
    "typecheck": "npm --prefix ../trace-core run build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tracedeck/trace-core": "0.1.0"
  }
}
